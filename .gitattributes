# Normalize line endings: LF in the repository, native handling left to git
* text=auto

# Sources and configs are always LF, even in Windows working trees
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
